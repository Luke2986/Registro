# Nomi delle variabili richieste, senza valori.
# In locale i valori stanno in .env.local, che non si committa mai.
# Su Vercel stanno nelle impostazioni del progetto, nei tre ambienti.
#
# Entrambe hanno prefisso NEXT_PUBLIC_ perché finiscono nel bundle del browser:
# lì può stare solo l'URL del progetto e la chiave pubblicabile.
# La chiave segreta e le stringhe di connessione Postgres non compaiono in questo file
# e non servono all'applicazione.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
